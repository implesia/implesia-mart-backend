# ---- Application ----
# Local development only. Production is render.yaml, which generates
# SECRET_KEY and uses Render Postgres and Redis. Do not deploy docker-compose.yml.
ENVIRONMENT=local
# DEBUG switches logs to human-readable console output and exposes /docs.
DEBUG=true
# SQL_ECHO logs every SQL statement. Very noisy — turn on only when debugging queries.
SQL_ECHO=false
PROJECT_NAME=Implesia Mart Backend
API_V1_PREFIX=/api/v1

# Comma separated list of origins allowed to call the API.
# 3000 is the Next.js storefront. 3001 is the vinext dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://impleasia.com,https://www.impleasia.com

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses a blank value, this placeholder, and anything under 32 characters.
SECRET_KEY=change-me-in-production
# Access tokens carry the login session id (sid = refresh-token family). Every
# authenticated request checks that session in Postgres, so logout, refresh-token
# reuse, password change and account disable end the access token immediately.
# The TTL only bounds how long a stolen token works while its session stays live.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Bearer token for GET /metrics (scrape with "Authorization: Bearer <token>").
# Empty = /metrics disabled (404) in every environment. Generate like SECRET_KEY.
METRICS_TOKEN=

# ---- Database ----
# Host ports sit one step above implesia-backend (Postgres 5433, Redis 6380, API 8000)
# so both projects can run on the same machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=implesia_mart
# Password for the local Compose database only.
POSTGRES_PASSWORD=implesia_mart
POSTGRES_DB=implesia_mart

# ---- Redis ----
REDIS_HOST_PORT=6381
REDIS_URL=redis://localhost:6381/0

# Socket peers allowed to supply CF-Connecting-IP and X-Forwarded-For.
# Leave this empty when browsers connect to the API directly.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.5
TRUSTED_PROXIES=

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN_IP=10/minute
RATE_LIMIT_LOGIN_ACCOUNT=10/minute
RATE_LIMIT_REFRESH_IP=10/minute
RATE_LIMIT_REFRESH_ACCOUNT=10/minute
RATE_LIMIT_ORDERS=5/hour
RATE_LIMIT_SEARCH=120/minute

# ---- Bootstrap superuser (used by scripts/create_superuser.py) ----
FIRST_SUPERUSER_EMAIL=admin@implesia.com
FIRST_SUPERUSER_PASSWORD=change-me-too

# ---- Email (optional). Leave SMTP_HOST empty to skip sending. ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@implesia.com
EMAIL_FROM_NAME=Implesia Mart
ORDER_NOTIFICATION_RECIPIENTS=

# ---- Cloudflare Turnstile ----
# Widget secret. No value in this file. Public POST /api/v1/orders reads
# turnstile_token from the JSON body and checks it with siteverify.
# Empty when ENVIRONMENT is not production: checkout skips the check.
# Empty when ENVIRONMENT=production: public checkout is refused. Set this
# before a production deploy.
TURNSTILE_SECRET_KEY=

# ---- Meta Conversions API (optional) ----
# Leave META_PIXEL_ID or META_CAPI_TOKEN empty to disable Purchase events.
# Pixel/Dataset ID: Meta Events Manager.
# Access token: Events Manager > Settings > Conversions API > Generate access token.
# Test event code: Events Manager > Test events. Leave empty outside testing.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ---- Telegram alerts (optional) ----
# Leave TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_IDS empty to send nothing.
# Create the bot with @BotFather (/newbot). TELEGRAM_CHAT_IDS is comma-separated.
# Group ids are negative. Get a chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates or from @userinfobot.
# Do not put the token or a real chat id in this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Both default off. Set to true to also alert when an order is cancelled,
# or when a product's stock first drops to LOW_STOCK_THRESHOLD (5) or below.
TELEGRAM_NOTIFY_ORDER_CANCELLED=false
TELEGRAM_NOTIFY_LOW_STOCK=false
# Storefront origin, no path. The staff message links to {ADMIN_BASE_URL}/admin/orders/{id}.
# The customer status link is {ADMIN_BASE_URL}/order-status?number={order number}.
# Empty means those messages have no link. Example: https://implesia.com
ADMIN_BASE_URL=

# ---- Customer order SMS (optional) ----
# Off until CUSTOMER_SMS_ENABLED=true. Nothing is sent to a phone.
# CUSTOMER_SMS_PROVIDER=log writes the text to the API log.
# CUSTOMER_SMS_PROVIDER=noop drops it. Any other value stops the process.
# ON_CONFIRMED and ON_SHIPPED apply only when the master flag is true.
CUSTOMER_SMS_ENABLED=false
CUSTOMER_SMS_PROVIDER=log
CUSTOMER_SMS_ON_CONFIRMED=true
CUSTOMER_SMS_ON_SHIPPED=true
# Days added to the order date for the printed estimated delivery date.
# Inside Dhaka and Dhaka-suburban use the first. Outside Dhaka uses the second.
# The date is computed on read. It is not stored. 0 to 60.
DELIVERY_DAYS_INSIDE_DHAKA=2
DELIVERY_DAYS_OUTSIDE_DHAKA=5
# Not read by the API. Setting these does not send SMS.
# A real send needs an SSL Wireless ISMS Plus (SMS Plus) account:
#   panel / docs: https://ismsplus.sslwireless.com/api-documentation
#   SMS_SSLWIRELESS_API_TOKEN = their api_token
#   SMS_SSLWIRELESS_SID = their registered sender id (sid)
#   SMS_SSLWIRELESS_API_URL = https://smsplus.sslwireless.com/api/v3/send-sms
# Also whitelist this server's outbound IP in that panel.
# Do not put the token or the sender id in this file.

# ---- Media storage ----
# Leave all five empty to keep uploads on local disk (media_root, ./media).
# Set all five together to store uploads in Cloudflare R2. A partial set
# stops the process on startup. The database still stores /media/<folder>/<name>.
# S3_ENDPOINT_URL is the account endpoint, for example
# https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=implesia-mart-media
# MEDIA_PUBLIC_BASE_URL is the bucket's public custom domain, with no path.
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=
