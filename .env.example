# ---- Application ----
ENVIRONMENT=local
# DEBUG switches logs to human-readable console output and exposes /docs.
DEBUG=true
# SQL_ECHO logs every SQL statement. Very noisy — turn on only when debugging queries.
SQL_ECHO=false
PROJECT_NAME=Implesia Mart Backend
API_V1_PREFIX=/api/v1

# Comma separated list of origins allowed to call the API.
# 3000 is the Next.js storefront. 3001 is the vinext dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://impleasia.com,https://www.impleasia.com

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
# Host ports sit one step above implesia-backend (Postgres 5433, Redis 6380, API 8000)
# so both projects can run on the same machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=implesia_mart
POSTGRES_PASSWORD=implesia_mart
POSTGRES_DB=implesia_mart

# ---- Redis ----
REDIS_HOST_PORT=6381
REDIS_URL=redis://localhost:6381/0

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_ORDERS=5/hour

# ---- Bootstrap superuser (used by scripts/create_superuser.py) ----
FIRST_SUPERUSER_EMAIL=admin@implesia.com
FIRST_SUPERUSER_PASSWORD=change-me-too

# ---- Email (optional). Leave SMTP_HOST empty to skip sending. ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@implesia.com
EMAIL_FROM_NAME=Implesia Mart
ORDER_NOTIFICATION_RECIPIENTS=

# ---- Cloudflare Turnstile (leave empty to disable verification) ----
TURNSTILE_SECRET_KEY=
