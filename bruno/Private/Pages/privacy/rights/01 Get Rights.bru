meta {
  name: Get Rights
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/privacy/rights
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the rights section for an editor", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("is_active");
    expect(body).to.have.property("heading");
    expect(body.items).to.be.an("array");
    expect(body.retention).to.have.property("is_active");
    expect(body.updates).to.have.property("is_active");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/privacy/rights

  Editor view. The first read creates an empty active rights section.
}
