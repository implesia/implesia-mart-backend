meta {
  name: List Dresses
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/dresses
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && Array.isArray(body)) {
    bru.setEnvVar("DRESS_IDS", JSON.stringify(body.map((dress) => dress.id)));
  }
}

tests {
  test("lists every custom dress", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/about/dresses

  Editor lists every custom-dress block, including hidden ones. Stores `DRESS_IDS` for Reorder. Run this first.
}
