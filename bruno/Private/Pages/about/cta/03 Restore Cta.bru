meta {
  name: Restore Cta
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/cta
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "is_active": true,
    "title": "আজই খুঁজে নিন আপনার প্রয়োজনীয় প্রোডাক্ট",
    "subtitle": "গ্যাজেট হোক বা গর্জিয়াস ড্রেস — হাতে পেয়ে দেখে তারপর ক্যাশ অন ডেলিভারি।",
    "primary_cta": { "label": "সব প্রোডাক্ট", "href": "/products" },
    "secondary_cta": { "label": "যোগাযোগ", "href": "/contact-us" }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("restores the seeded block", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.is_active).to.equal(true);
    expect(body.primary_cta.label).to.equal("সব প্রোডাক্ট");
    expect(body.secondary_cta.href).to.equal("/contact-us");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/about/cta

  Puts the seeded closing block back on the about page.
}
