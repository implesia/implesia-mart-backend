meta {
  name: List Cta
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/cta
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the closing block", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.title).to.equal("আজই খুঁজে নিন আপনার প্রয়োজনীয় প্রোডাক্ট");
    expect(body.is_active).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/about/cta

  Editor reads the closing block, including when it is hidden.
}
