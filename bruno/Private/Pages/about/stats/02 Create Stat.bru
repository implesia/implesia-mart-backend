meta {
  name: Create Stat
  type: http
  seq: 2
}

post {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/stats
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "icon": "verified",
    "value": "৭",
    "label": "Bruno stat check",
    "is_active": false
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.id) {
    bru.setEnvVar("STAT_ID", body.id);
    const ids = JSON.parse(bru.getEnvVar("STAT_IDS") || "[]").filter((id) => id !== body.id);
    bru.setEnvVar("STAT_ORDER", JSON.stringify([body.id, ...ids]));
  }
}

assert {
  res.status: eq 201
}

tests {
  test("adds a hidden stat", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.be.a("string");
    expect(body.value).to.equal("৭");
    expect(body.label).to.equal("Bruno stat check");
    expect(body.icon).to.equal("verified");
    expect(body.is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # POST /api/v1/admin/pages/about/stats

  Adds a hidden stat so the public bar does not change. Stores `STAT_ID` and `STAT_ORDER`.
}
