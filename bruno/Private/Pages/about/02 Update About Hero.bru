meta {
  name: Update About Hero
  type: http
  seq: 2
}

put {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/hero
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:multipart-form {
  payload: {"eyebrow":"আমাদের সম্পর্কে","title":"Bruno about hero check","subtitle":"ঘরে বসে কোয়ালিটি চেক করা প্রোডাক্ট — ক্যাশ অন ডেলিভারিতে, কোনো আগাম ঝুঁকি ছাড়াই। ট্রেন্ডিং গ্যাজেট আর হাতে তৈরি গর্জিয়াস ড্রেস, একই বিশ্বাসে।","primary_label":"সব প্রোডাক্ট","primary_href":"/products","secondary_label":"যোগাযোগ","secondary_href":"/contact-us","images":[{"alt":"সানসেট ল্যাম্প — ইমপ্লেসিয়া মার্টের ট্রেন্ডিং গ্যাজেট","src":""},{"alt":"হাতে তৈরি গর্জিয়াস উইমেন্স গাউন","src":"/images/products/baby-products/female-gorgious-ground-dress.jpeg"}]}
  image_0: @file(fixtures/about-hero.jpg)
}

assert {
  res.status: eq 200
}

tests {
  test("saves the heading and left photo together", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.title).to.equal("Bruno about hero check");
    expect(body.images[0].src).to.match(/^\/media\/about\//);
    expect(body.images[1].src).to.equal("/images/products/baby-products/female-gorgious-ground-dress.jpeg");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PUT /api/v1/admin/pages/about/hero

  Replaces the about banner as `multipart/form-data`. `payload` is the heading, buttons, and photo list. `image_0` and `image_1` are optional JPEG, PNG, WEBP, or GIF files for those slots. A file replaces `src` for that photo.

  This request uploads a left photo and changes the title. Restore About Hero puts the seeded banner back.
}
