meta {
  name: List Steps
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/about/steps
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && Array.isArray(body.items)) {
    bru.setEnvVar("STEP_IDS", JSON.stringify(body.items.map((item) => item.id)));
  }
}

tests {
  test("lists the heading and every step", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.title).to.equal("কীভাবে অর্ডার করবেন");
    expect(body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/about/steps

  Editor lists the heading and every step, including hidden ones. Stores `STEP_IDS` for Reorder. Run this first.
}
