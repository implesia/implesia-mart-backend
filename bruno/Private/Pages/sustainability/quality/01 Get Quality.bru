meta {
  name: Get Quality
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/quality
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the quality section including hidden steps", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.steps).to.be.an("array");
    expect(body.steps[0]).to.have.property("is_active");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/sustainability/quality

  Admin quality block, including hidden steps and badges.
}
