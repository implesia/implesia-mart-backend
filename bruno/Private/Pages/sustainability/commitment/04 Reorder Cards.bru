meta {
  name: Reorder Cards
  type: http
  seq: 4
}

put {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/commitment/items/order
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "ids": {{COMMIT_ORDER}}
  }
}

assert {
  res.status: eq 200
}

tests {
  test("moves the fixture first", function () {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().items;
    expect(items[0].id).to.equal(bru.getEnvVar("COMMIT_ID"));
    expect(items[0].is_active).to.equal(false);
    expect(items.map((item) => item.id)).to.deep.equal(JSON.parse(bru.getEnvVar("COMMIT_ORDER")));
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PUT /api/v1/admin/pages/sustainability/commitment/items/order

  The fixture stays hidden, so the public cards keep their previous order.
}
