meta {
  name: Update Card
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/commitment/items/{{COMMIT_ID}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "icon": "verified",
    "title": "Card check",
    "description": "Hidden card",
    "is_active": false
  }
}

assert {
  res.status: eq 200
}

tests {
  test("keeps the fixture hidden", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("COMMIT_ID"));
    expect(body.title).to.equal("Card check");
    expect(body.is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/sustainability/commitment/items/{id}

  Replaces one card. This request stays hidden.
}
