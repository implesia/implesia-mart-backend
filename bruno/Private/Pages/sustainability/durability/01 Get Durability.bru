meta {
  name: Get Durability
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/durability
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the durability section including hidden points", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.bullets).to.be.an("array");
    expect(body.bullets[0]).to.have.property("is_active");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/sustainability/durability

  Admin durability block, including hidden points.
}
