meta {
  name: Restore Sustainability Hero
  type: http
  seq: 3
}

put {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/hero
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:multipart-form {
  payload: {"eyebrow":"সাসটেইনেবিলিটি","title":"দায়িত্বশীল শপিং, দীর্ঘস্থায়ী প্রোডাক্ট","subtitle":"ভালো প্রোডাক্ট মানেই কম রিপ্লেসমেন্ট, কম বর্জ্য। গ্যাজেট যাচাই করে আর গর্জিয়াস ড্রেস হাতে তৈরি করে — দায়িত্বশীল প্যাকেজিংয়ে পাঠাই।","primary_label":"সব প্রোডাক্ট","primary_href":"/products","secondary_label":"আমাদের সম্পর্কে","secondary_href":"/about-us","images":[{"alt":"সানসেট ল্যাম্প — কোয়ালিটি চেক করা গ্যাজেট","src":"/images/products/lamp/lamp-1.jpg"},{"alt":"হাতে তৈরি গর্জিয়াস উইমেন্স গাউন","src":"/images/products/baby-products/female-gorgious-ground-dress.jpeg"}]}
}

assert {
  res.status: eq 200
}

tests {
  test("puts the seeded banner back", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.title).to.equal("দায়িত্বশীল শপিং, দীর্ঘস্থায়ী প্রোডাক্ট");
    expect(body.images[0].src).to.equal("/images/products/lamp/lamp-1.jpg");
    expect(body.images[1].src).to.equal("/images/products/baby-products/female-gorgious-ground-dress.jpeg");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PUT /api/v1/admin/pages/sustainability/hero

  Puts the seeded sustainability banner back after the update request.
}
