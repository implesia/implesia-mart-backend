meta {
  name: Remove Origin Photo
  type: http
  seq: 2
}

put {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/sustainability/origin
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:multipart-form {
  payload: {"eyebrow":"আমাদের দৃষ্টিভঙ্গি","title":"কোয়ালিটি এখন বিলাসিতা নয়, দায়িত্ব","body":"ইমপ্লেসিয়া মার্ট শুরু হয়েছিল একটা সহজ প্রশ্ন থেকে — কেন ভালো প্রোডাক্ট মানেই বেশি ঝুঁকি হবে? প্রতিটি গ্যাজেট অর্ডারের আগে নিজেরা টেস্ট করি, আর প্রতিটি ড্রেস হাতে বানিয়ে চেক করে পাঠাই — যাতে প্রথমবারেই সঠিক জিনিস হাতে পান। কম রিটার্ন, কম বর্জ্য।","quote":"কোয়ালিটি একটি অভ্যাস, একবারের কাজ নয়।","image":null}
}

assert {
  res.status: eq 200
}

tests {
  test("saves the point of view without a photo", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().image).to.equal(null);
    expect(res.getBody().images).to.have.lengthOf(0);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PUT /api/v1/admin/pages/sustainability/origin

  The photo is optional: removes it. Restore Origin puts it back. Run them together.
}
