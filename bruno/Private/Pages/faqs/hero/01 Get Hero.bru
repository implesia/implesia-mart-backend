meta {
  name: Get Hero
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/faqs/hero
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the hero for an editor", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("is_active");
    expect(body).to.have.property("title");
    expect(body).to.have.property("trending");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/faqs/hero

  Editor view. Includes is_active. The first read is blank until someone saves a title.
}
