meta {
  name: Get Help
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/faqs/help
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the help banner for an editor", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("is_active");
    expect(body).to.have.property("title");
    expect(body).to.have.property("subtitle");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/faqs/help

  Editor view. The first read creates an empty active banner.
}
