meta {
  name: Hide Hero
  type: http
  seq: 2
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/blogs/hero
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "is_active": false,
    "eyebrow": "Blog",
    "title": "Guides",
    "subtitle": "Short guides.",
    "count_label": "articles"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("hides the hero", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/blogs/hero

  Hides the banner. Restore Hero puts a visible banner back.
}
