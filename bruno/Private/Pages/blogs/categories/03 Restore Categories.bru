meta {
  name: Restore Categories
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/blogs/categories
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "is_active": true,
    "items": [
      {
        "label": "Guides",
        "is_active": true
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("shows the categories again", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().is_active).to.equal(true);
    expect(res.getBody().items[0].label).to.equal("Guides");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/blogs/categories

  Saves the filter chips and shows them on the blog list.
}
