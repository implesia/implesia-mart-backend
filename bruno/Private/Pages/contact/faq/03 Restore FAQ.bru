meta {
  name: Restore FAQ
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/contact/faq
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "is_active": true,
    "title": "Questions",
    "subtitle": "",
    "items": [
      {
        "question": "When do you reply?",
        "answer": "During working hours.",
        "is_active": true
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("shows the FAQ again", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().is_active).to.equal(true);
    expect(res.getBody().title).to.equal("Questions");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/contact/faq

  Saves the questions and shows them on the contact page.
}
