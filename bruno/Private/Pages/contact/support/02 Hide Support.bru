meta {
  name: Hide Support
  type: http
  seq: 2
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/contact/support
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "is_active": false,
    "title": "Support",
    "subtitle": "",
    "hours": [
      { "label": "Saturday", "value": "9:00 – 22:00", "is_active": true }
    ],
    "quick_links": [
      { "icon": "help", "label": "Questions", "href": "/faqs", "is_active": true }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("hides support", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/pages/contact/support

  Hides the support block. Restore Support puts a visible block back.
}
