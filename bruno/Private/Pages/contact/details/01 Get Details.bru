meta {
  name: Get Details
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/pages/contact/details
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the contacts for an editor", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("is_active");
    expect(body.channels).to.be.an("array");
    expect(body.social.map((item) => item.platform)).to.deep.equal([
      "facebook",
      "linkedin",
    ]);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/admin/pages/contact/details

  Editor view. Includes is_active. The first read is blank until someone saves.
}
