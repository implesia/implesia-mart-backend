get {
url: {{PRIVATE_BASE_URL}}/api/v1/admin/dashboard
body: none
auth: bearer
}

auth:bearer {
token: {{ACCESS_TOKEN}}
}

headers {
Accept: application/json
}

docs {
# GET /api/v1/admin/dashboard

Admin overview. Editor or superadmin. Viewer is `403`.

Query: `range` is `today`, `yesterday`, `7d` (default), `30d`, `this-month`,
`last-month`, or `custom`. Custom also needs `from` and `to` as `YYYY-MM-DD`.
Days are Asia/Dhaka. Revenue excludes cancelled and returned orders.

## Errors

`401` — not signed in. `403` `forbidden` — role is below editor.
`422` — custom range is missing dates or longer than 366 days.
}

tests {
test("returns the shop overview", function () {
expect(res.getStatus()).to.equal(200)           ;
const body = res.getBody()                      ;
expect(body.range).to.equal("7d");
expect(body.revenue.value).to.be.a("number");
expect(body.orders.value).to.be.a("number");
expect(body.statuses).to.have.lengthOf(6)       ;
})                                              ;
}

assert {
res.status: eq 200
}

