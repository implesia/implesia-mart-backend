meta {
  name: Summary
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/dashboard
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/admin/dashboard

  Admin home counts. Editor or superadmin. Viewer is `403`.

  No request body.

  ## Response `200`

  ```json
  { "users_total": 1, "users_active": 1 }
  ```

  Order counts are added with the order module.

  ## Errors

  `401` — not signed in. `403` `forbidden` — role is below editor.
}


tests {
  test("returns staff counts", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.users_total).to.be.a("number");
    expect(body.users_active).to.be.a("number");
    expect(body.users_total).to.be.at.least(1);
    expect(body.users_active).to.be.at.least(1);
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Staff counts

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/admin/dashboard
    method: GET
    headers: {
      Accept: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        { "users_total": 1, "users_active": 1 }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
