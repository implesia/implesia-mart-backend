meta {
  name: Delete User
  type: http
  seq: 5
}

delete {
  url: {{PRIVATE_BASE_URL}}/api/v1/users/{{USER_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
}

docs {
  # DELETE /api/v1/users/{id}

  Deletes `USER_ID` from **Create User**. Do not paste the admin id.

  No request body.

  ## Response `204`

  Empty body.

  ## Errors

  `403` — you cannot delete yourself, or the last active superadmin. `404` — id is already gone.
}


tests {
  test("deletes the demo user", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

assert {
  res.status: eq 204
}

example {
  name: 204 No Content
  description: Deletes the demo user

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/users/{{USER_ID}}
    method: DELETE
    headers: {
      Accept: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 204
      text: No Content
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
