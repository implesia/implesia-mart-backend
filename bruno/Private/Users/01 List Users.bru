meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

params:query {
  page: 1
  page_size: 20
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/users

  Superadmin staff list.

  ## Query

  `page=1` and `page_size=20`.

  No request body.

  ## Response `200`

  ```json
  {
    "items": [
      {
        "email": "admin@implesia.com",
        "full_name": "Implesia Mart Admin",
        "role": "superadmin",
        "is_active": true,
        "id": "09d0379f-b3d6-459c-a86e-05ef573b8704",
        "last_login_at": "2026-09-28T07:20:02.968481Z",
        "created_at": "2026-09-28T07:07:07.896517Z"
      }
    ],
    "total": 1,
    "page": 1,
    "page_size": 20
  }
  ```

  ## Errors

  `401` not signed in. `403` the account is not a superadmin.
}


tests {
  test("lists staff", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.be.an("array");
    expect(body.total).to.be.a("number");
    expect(body.page).to.equal(1);
    expect(body.page_size).to.equal(20);
    expect(body.items[0].email).to.be.a("string");
    expect(body.items[0].password_hash).to.equal(undefined);
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Lists staff

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/users
    method: GET
    params:query: {
      page: 1
      page_size: 20
    }
    headers: {
      Accept: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "email": "admin@implesia.com",
              "full_name": "Implesia Mart Admin",
              "role": "superadmin",
              "is_active": true,
              "id": "09d0379f-b3d6-459c-a86e-05ef573b8704",
              "last_login_at": "2026-09-28T07:20:02.968481Z",
              "created_at": "2026-09-28T07:07:07.896517Z"
            }
          ],
          "total": 1,
          "page": 1,
          "page_size": 20
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
