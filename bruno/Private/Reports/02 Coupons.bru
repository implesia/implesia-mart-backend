meta {
  name: Coupons
  type: http
  seq: 2
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/reports/coupons?from=2026-11-01&to=2026-11-10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/admin/reports/coupons

  Any signed-in staff, including viewer. Read only.

  Query: the same date window as the other reports (`preset`, or both `from` and `to`).
  Days are Asia/Dhaka. This report counts a redemption when the order was placed
  (`coupon_redemptions.created_at`), not when it was delivered. Cancelled uses are
  left out. A returned order stays in. `product_id`, `category_id`, and `channel`
  are accepted and ignored (`channel_applies` is false).

  Each item: `{ coupon_id, code, times_used, total_discount, total_sales }`.
  `total_sales` is the sum of those orders' totals after the coupon, including delivery.

  The same path with `/export` downloads `.xlsx`.
}

tests {
  test("returns the coupon report", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.filters.channel_applies).to.equal(false);
    expect(res.body).to.have.property("items");
    expect(res.body).to.have.property("times_used");
  });
}
