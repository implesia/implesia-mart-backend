meta {
  name: Change Password
  type: http
  seq: 2
}

post {
  url: {{PRIVATE_BASE_URL}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "current_password": "{{ADMIN_PASSWORD}}",
    "new_password": "ReplaceMe#OnlyWhenYouMeanIt"
  }
}

docs {
  # POST /api/v1/auth/change-password

  Do not run this in the normal suite. It changes the admin password to
  `ReplaceMe#OnlyWhenYouMeanIt` and Local login will fail until `.env` and
  `ADMIN_PASSWORD` match the new value.

  **Expected:** `200` `{ "message": "Password updated" }`
}

tests {
  test("updates the password", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Password updated");
  });
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 25000
}
