meta {
  name: Change Password
  type: http
  seq: 2
}

post {
  url: {{PRIVATE_BASE_URL}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "current_password": "{{ADMIN_PASSWORD}}",
    "new_password": "ReplaceMe#OnlyWhenYouMeanIt"
  }
}

docs {
  # POST /api/v1/auth/change-password

  Changes the signed-in user's password. Do not run this in the normal suite. It replaces the admin password with `ReplaceMe#OnlyWhenYouMeanIt`, and Local login fails until `.env` and `ADMIN_PASSWORD` match.

  ## Request body

  ```json
  {
    "current_password": "{{ADMIN_PASSWORD}}",
    "new_password": "ReplaceMe#OnlyWhenYouMeanIt"
  }
  ```

  `new_password` must be 12–72 characters.

  ## Response `200`

  ```json
  { "message": "Password updated" }
  ```

  ## Errors

  `401` — current password is wrong.
}


tests {
  test("updates the password", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Password updated");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Password updated

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/auth/change-password
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }
    body:json: {
      {
        "current_password": "{{ADMIN_PASSWORD}}",
        "new_password": "ReplaceMe#OnlyWhenYouMeanIt"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        { "message": "Password updated" }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
