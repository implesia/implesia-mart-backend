meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/auth/me

  Any active role. Run **Public / Auth / Login** first.

  **Expected:** `200` current user. No password hash.
}

tests {
  test("returns the signed-in admin", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.email).to.equal("admin@implesia.com");
    expect(body.role).to.equal("superadmin");
    expect(body.id).to.be.a("string");
    expect(body.password_hash).to.equal(undefined);
  });
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 25000
}
