meta {
  name: Get Product
  type: http
  seq: 3
}

get {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/products/{{PRODUCT_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
}

docs {
  # GET /api/v1/admin/products/{id}

  Full product for the edit form, including `content`. Uses `PRODUCT_ID` from Create Product.

  ## Errors

  `404` `not_found` — id is not in the catalog. `422` — id is not a UUID.

  ## Response `200`

  Same shape as Create Product: id, slug, price, stock, publish flags, and the full `content` object.
}

tests {
  test("returns the created product", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("PRODUCT_ID"));
    expect(body.slug).to.equal(bru.getEnvVar("PRODUCT_SLUG"));
    expect(body.content.description).to.be.a("string");
    expect(body).to.have.property("quantity");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Product for the edit form

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/admin/products/{{PRODUCT_ID}}
    method: GET
    headers: {
      Accept: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }
  }

  response: {
    headers: {
      content-type: application/json
