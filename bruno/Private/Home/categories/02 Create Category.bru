meta {
  name: Create Category
  type: http
  seq: 2
}

post {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/home/categories/tiles
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:multipart-form {
  payload: {"label":"Bruno category check","href":"","image_src":"/images/products/lamp/lamp-5.jpg","is_active":false}
}

assert {
  res.status: eq 201
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.id) {
    bru.setEnvVar("CATEGORY_TILE_ID", body.id);
    const ids = JSON.parse(bru.getEnvVar("CATEGORY_IDS") || "[]").filter((id) => id !== body.id);
    bru.setEnvVar("CATEGORY_IDS", JSON.stringify([...ids, body.id]));
    bru.setEnvVar("CATEGORY_ORDER", JSON.stringify([body.id, ...ids]));
  }
}

tests {
  test("creates a hidden category", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.be.a("string");
    expect(body.label).to.equal("Bruno category check");
    expect(body.href).to.equal("/products");
    expect(body.image_src).to.equal("/images/products/lamp/lamp-5.jpg");
    expect(body.is_active).to.equal(false);
    expect(body.sort_order).to.be.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # POST /api/v1/admin/home/categories/tiles

  Editor adds a tile as `multipart/form-data`. `payload` is the tile JSON. `image` is an optional JPEG, PNG, WEBP, or GIF. This request keeps `is_active` false and uses a static image path, so the public grid does not change. A blank `href` is stored as `/products`.

  Stores `CATEGORY_TILE_ID` and `CATEGORY_ORDER` (the new id first, then the ids from List Categories). Run List Categories first.
}
