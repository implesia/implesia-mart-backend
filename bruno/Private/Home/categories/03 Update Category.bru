meta {
  name: Update Category
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/home/categories/tiles/{{CATEGORY_TILE_ID}}
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:multipart-form {
  payload: {"label":"Bruno category updated","is_active":false}
}

assert {
  res.status: eq 200
}

tests {
  test("updates the fixture category", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("CATEGORY_TILE_ID"));
    expect(body.label).to.equal("Bruno category updated");
    expect(body.href).to.equal("/products");
    expect(body.is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/home/categories/tiles/{id}

  Partial update as `multipart/form-data`. Omitted fields stay as they are. This request keeps the fixture hidden.
}
