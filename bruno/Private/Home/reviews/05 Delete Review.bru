meta {
  name: Delete Review
  type: http
  seq: 5
}

delete {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/home/reviews/items/{{REVIEW_ITEM_ID}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("removes the fixture", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.equal("Review removed");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # DELETE /api/v1/admin/home/reviews/items/{id}

  Removes the fixture. An uploaded `/media/reviews/` file is deleted with it. Static `/images/` paths are left in place.
}
