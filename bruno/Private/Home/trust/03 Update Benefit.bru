meta {
  name: Update Benefit
  type: http
  seq: 3
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/home/trust/{{TRUST_ITEM_ID}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "label": "Bruno trust updated",
    "is_active": false
  }
}

assert {
  res.status: eq 200
}

tests {
  test("updates the fixture benefit", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("TRUST_ITEM_ID"));
    expect(body.label).to.equal("Bruno trust updated");
    expect(body.icon).to.equal("verified");
    expect(body.href).to.equal("/shipping-returns");
    expect(body.is_active).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # PATCH /api/v1/admin/home/trust/{item_id}

  Editor updates one benefit. Send only the fields that change. Uses `TRUST_ITEM_ID` from Create Benefit.

  This request renames the fixture and keeps it hidden. A blank `href` becomes `/shipping-returns`. A blank `label` is `422`.

  ## Response `200`

  The updated benefit.

  ## Errors

  `404` `not_found`. `422` `validation_error`. `401` / `403` — auth.
}

example {
  name: 200 OK
  description: Benefit renamed

  request: {
    url: {{PRIVATE_BASE_URL}}/api/v1/admin/home/trust/{{TRUST_ITEM_ID}}
    method: PATCH
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
      Authorization: Bearer {{ACCESS_TOKEN}}
    }

    body:json: {
      {
        "label": "Bruno trust updated",
        "is_active": false
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "id": "a4fe249a-b466-4c69-a956-94d14e4c8bee",
          "icon": "verified",
          "label": "Bruno trust updated",
          "href": "/shipping-returns",
          "is_active": false,
          "sort_order": 3
        }
      '''
    }
  }
}
