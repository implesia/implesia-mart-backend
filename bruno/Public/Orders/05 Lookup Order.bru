meta {
  name: Lookup Order
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/v1/orders/lookup
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "number": "{{ORDER_NUMBER}}",
    "phone": "01700000000"
  }
}

docs {
  # POST /api/v1/orders/lookup

  Public status for an anonymous customer. Send the phone plus exactly one of `number` or `tracking_number`. Both, or neither, is 422. A wrong phone, an unknown number, and an unknown tracking id return the same 404.

  The response has `status`, `timeline` (`status` and `at` only), `courier_name`, `tracking_number`, `items` (including `variant_label`), totals, and `due_amount` (cash still due). No order id, street address, email, notes, or full phone. The route is limited per address (`RATE_LIMIT_ORDER_LOOKUP`, default 30/minute).
}
