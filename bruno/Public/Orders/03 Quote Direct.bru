meta {
  name: Quote Direct
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/orders/quote
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "source": "direct",
    "district": "চট্টগ্রাম",
    "items": [
      {
        "product_id": "{{PRODUCT_ID}}",
        "quantity": 1
      }
    ]
  }
}

docs {
  # POST /api/v1/orders/quote

  Prices a buy-now list. This does not read or clear the cart. Do not send `unit_price`.
}
