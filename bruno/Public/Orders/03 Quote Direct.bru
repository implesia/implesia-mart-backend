meta {
  name: Quote Direct
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/v1/orders/quote
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "source": "direct",
    "district": "চট্টগ্রাম",
    "items": [
      {
        "product_id": "{{PRODUCT_ID}}",
        "quantity": 1
      }
    ]
  }
}

docs {
  # POST /api/v1/orders/quote

  Prices a buy-now list. This does not read or clear the cart. Do not send `unit_price`.

  Optional `coupon_code` (string). Optional `phone` (the same mobile form as an order) so the quote can check the per-phone limit and the first-order rule. A blank code is no coupon.

  The response adds `coupon`: null, or `{ code, valid, discount, free_delivery, error_code, message }`. An invalid code does not fail the quote. `total` and `shipping` already include a valid coupon. `subtotal` stays the merchandise after the quantity discount, before the coupon.
}
