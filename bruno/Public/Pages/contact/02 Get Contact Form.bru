meta {
  name: Get Contact Form
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/v1/pages/contact/form
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the message form", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body.fields).to.have.keys("name", "phone", "subject", "message");
    expect(body.fields.name).to.have.keys("label", "placeholder");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/contact/form

  Public message form. A hidden or unsaved form comes back with an empty title.
}
