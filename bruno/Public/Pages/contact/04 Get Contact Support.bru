meta {
  name: Get Contact Support
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/api/v1/pages/contact/support
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the support block", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body.hours).to.be.an("array");
    expect(body.quick_links).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/contact/support

  Public support hours and links. A hidden or unsaved block comes back with an empty title.
}
