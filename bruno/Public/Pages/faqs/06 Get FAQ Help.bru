meta {
  name: Get FAQ Help
  type: http
  seq: 6
}

get {
  url: {{BASE_URL}}/api/v1/pages/faqs/help
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the FAQ help banner", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("title");
    expect(body).to.have.property("subtitle");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/faqs/help

  Contact banner under the questions. A hidden banner, or one without a title, comes back blank.
}
