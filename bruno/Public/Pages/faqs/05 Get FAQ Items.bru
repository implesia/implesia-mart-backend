meta {
  name: Get FAQ Items
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/api/v1/pages/faqs/items
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the FAQ questions", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("items");
    expect(body.items).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/faqs/items

  Active questions on the FAQ page. Hidden questions are left out. The first read is an empty list.
}
