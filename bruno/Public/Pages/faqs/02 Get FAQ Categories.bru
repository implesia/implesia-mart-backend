meta {
  name: Get FAQ Categories
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/v1/pages/faqs/categories
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the FAQ categories", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("title");
    expect(body).to.have.property("items");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/faqs/categories

  Sidebar topics on the FAQ page. A hidden sidebar, or one with no copy, comes back blank.
}
