meta {
  name: Get Blog Hero
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/v1/pages/blogs/hero
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the blog hero", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("title");
    expect(body).to.have.property("count_label");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/blogs/hero

  Public blog banner. A hidden or unsaved hero comes back with an empty title.
}
