meta {
  name: Get Sustainability Origin
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/v1/pages/sustainability/origin
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the point of view and active photos", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.title).to.equal("কোয়ালিটি এখন বিলাসিতা নয়, দায়িত্ব");
    expect(body.images).to.be.an("array").that.is.not.empty;
    expect(body.images[0]).to.not.have.property("is_active");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/sustainability/origin

  Public point of view. Hidden photos are omitted.
}
