meta {
  name: Get Privacy Usage
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/api/v1/pages/privacy/usage
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the privacy usage section", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("heading");
    expect(body.items).to.be.an("array");
    expect(body.protection.badges).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/privacy/usage

  How information is used. A hidden section, or one without a heading, comes back blank.
}
