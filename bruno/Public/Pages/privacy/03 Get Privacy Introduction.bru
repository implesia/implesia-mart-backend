meta {
  name: Get Privacy Introduction
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/v1/pages/privacy/introduction
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the privacy introduction", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("heading");
    expect(body.paragraphs).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/privacy/introduction

  Opening section. A hidden section, or one without a heading, comes back blank.
}
