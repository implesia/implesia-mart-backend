meta {
  name: Get Shipping Hero
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/v1/pages/shipping/hero
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the shipping hero", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("eyebrow");
    expect(body).to.have.property("title");
    expect(body).to.have.property("subtitle");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/shipping/hero

  Banner at the top of the shipping page. A hidden banner, or one without a title, comes back blank.
}
