meta {
  name: Get Shipping Payment
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/api/v1/pages/shipping/payment
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("returns the payment section", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.have.property("is_active");
    expect(body).to.have.property("heading");
    expect(body.cards).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 25000
}

docs {
  # GET /api/v1/pages/shipping/payment

  Payment methods on the shipping page. A hidden or untitled section comes back blank.
}
