meta {
  name: Root
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  # GET /

  Service identity. No request body.

  ## Response `200`

  ```json
  {
    "name": "Implesia Mart Backend",
    "version": "0.1.0",
    "docs": "/docs"
  }
  ```

  `/docs` is hidden when `ENVIRONMENT=production`.
}


tests {
  test("names the API", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Implesia Mart Backend");
    expect(res.getBody().version).to.be.a("string");
    expect(res.getBody().docs).to.equal("/docs");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Names the API

  request: {
    url: {{BASE_URL}}/
    method: GET
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "name": "Implesia Mart Backend",
          "version": "0.1.0",
          "docs": "/docs"
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
