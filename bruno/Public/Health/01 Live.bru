meta {
  name: Live
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/health/live
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  # GET /health/live

  Liveness probe. Does not touch Postgres or Redis.

  No request body.

  ## Response `200`

  ```json
  { "status": "ok" }
  ```
}


tests {
  test("process is alive", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Process is alive

  request: {
    url: {{BASE_URL}}/health/live
    method: GET
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        { "status": "ok" }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
