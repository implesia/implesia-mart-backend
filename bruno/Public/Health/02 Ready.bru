meta {
  name: Ready
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/health/ready
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  # GET /health/ready

  Readiness probe. Runs `SELECT 1` against Postgres.

  No request body.

  ## Response `200`

  ```json
  { "status": "ok", "database": "ok" }
  ```

  If Postgres is down the status stays `200` and `database` is `unreachable`.
}


tests {
  test("database is reachable", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
    expect(res.getBody().database).to.equal("ok");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Database is reachable

  request: {
    url: {{BASE_URL}}/health/ready
    method: GET
    headers: {
      Accept: application/json
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        { "status": "ok", "database": "ok" }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
