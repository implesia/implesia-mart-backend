meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}"
  }
}

docs {
  # POST /api/v1/auth/login

  Staff login. No Bearer token.

  ## Request body

  ```json
  {
    "email": "admin@implesia.com",
    "password": "change-me-too"
  }
  ```

  `email` and `password` come from `ADMIN_EMAIL` and `ADMIN_PASSWORD`.

  ## Response `200`

  ```json
  {
    "access_token": "<jwt>",
    "refresh_token": "<jwt>",
    "token_type": "bearer",
    "expires_in": 1800
  }
  ```

  The post-response script stores both tokens. Access tokens last 30 minutes.

  ## Errors

  `401` `unauthenticated` — wrong email or password, or the account is disabled.

  ```json
  { "error": { "code": "unauthenticated", "message": "Incorrect email or password", "details": null } }
  ```
}


script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.access_token) {
    bru.setEnvVar("ACCESS_TOKEN", body.access_token);
    bru.setEnvVar("REFRESH_TOKEN", body.refresh_token);
  }
}

tests {
  test("returns a token pair", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.access_token).to.be.a("string");
    expect(body.refresh_token).to.be.a("string");
    expect(body.token_type).to.equal("bearer");
    expect(body.expires_in).to.be.a("number");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Returns a token pair

  request: {
    url: {{BASE_URL}}/api/v1/auth/login
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
    }
    body:json: {
      {
        "email": "{{ADMIN_EMAIL}}",
        "password": "{{ADMIN_PASSWORD}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.access",
          "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.refresh",
          "token_type": "bearer",
          "expires_in": 1800
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
