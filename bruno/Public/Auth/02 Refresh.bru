meta {
  name: Refresh
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{REFRESH_TOKEN}}"
  }
}

docs {
  # POST /api/v1/auth/refresh

  Exchange a refresh token for a new pair. Run **Login** first. An access token in this body is `401`.

  ## Request body

  ```json
  { "refresh_token": "{{REFRESH_TOKEN}}" }
  ```

  ## Response `200`

  Same shape as login: `access_token`, `refresh_token`, `token_type`, `expires_in`.

  Both environment variables are replaced.

  ## Errors

  `401` `unauthenticated` — token is missing, expired, or is an access token.
}


script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.access_token) {
    bru.setEnvVar("ACCESS_TOKEN", body.access_token);
    bru.setEnvVar("REFRESH_TOKEN", body.refresh_token);
  }
}

tests {
  test("rotates the token pair", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.access_token).to.be.a("string");
    expect(body.refresh_token).to.be.a("string");
    expect(body.token_type).to.equal("bearer");
  });
}

assert {
  res.status: eq 200
}

example {
  name: 200 OK
  description: Rotates the token pair

  request: {
    url: {{BASE_URL}}/api/v1/auth/refresh
    method: POST
    mode: json
    headers: {
      Accept: application/json
      Content-Type: application/json
    }
    body:json: {
      {
        "refresh_token": "{{REFRESH_TOKEN}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.access",
          "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.refresh",
          "token_type": "bearer",
          "expires_in": 1800
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 25000
}
